{
  "name": "@omn1/ui-web",
  "version": "0.1.0",
  "description": "OMN1 design system \u2014 React + Tailwind components for the web.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@omn1/icons": "workspace:*",
    "@omn1/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@omn1/tailwind-config": "workspace:*",
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3.3.0 <4"
  },
  "devDependencies": {
    "@omn1/tailwind-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.75.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
