{
  "name": "@omn1/ui-native",
  "version": "0.1.0",
  "description": "OMN1 design system \u2014 React Native components styled with NativeWind (same Tailwind preset as the web).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@omn1/icons": "workspace:*",
    "@omn1/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@omn1/tailwind-config": "workspace:*",
    "lucide-react-native": ">=0.400.0",
    "nativewind": "^4.2.0",
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-svg": ">=15",
    "tailwindcss": ">=3.3.0 <4"
  },
  "devDependencies": {
    "@omn1/tailwind-config": "workspace:*",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "lucide-react-native": "^1.75.0",
    "nativewind": "^4.2.7",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-svg": "^15.16.1",
    "tailwindcss": "^3.4.19",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
